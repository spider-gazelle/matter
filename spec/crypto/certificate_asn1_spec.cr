require "../spec_helper"

# The issuer of a Matter certificate signs its ASN.1 DER form, so the conversion
# from the TLV that travels on the wire has to be byte-exact or every signature
# check fails. These are the certificate vectors matter.js tests against
# (`packages/protocol/test/certificate/TestCertificates.ts`): the operational
# certificates of the specification itself and of shipping ecosystems, each with
# the DER its own implementation produced.
CERTIFICATE_VECTORS = [
  {
    name: "General Test Certificates ROOT",
    tlv:  "",
    asn1: "",
  },
  {
    name: "General Test Certificates NOC",
    tlv:  "",
    asn1: "",
  },
  {
    name: "Matter 1.2 Specification Certificates ROOT",
    tlv:  "",
    asn1: "",
  },
  {
    name: "Apple Certificates ROOT",
    tlv:  "",
    asn1: "",
  },
  {
    name: "Apple Certificates NOC",
    tlv:  "",
    asn1: "",
  },
  {
    name: "Google Certificates ROOT",
    tlv:  "",
    asn1: "",
  },
  {
    name: "Amazon Certificates ROOT",
    tlv:  "",
    asn1: "",
  },
  {
    name: "Amazon Certificates NOC",
    tlv:  "",
    asn1: "",
  },
  {
    name: "SmartThings Certificates ROOT",
    tlv:  "",
    asn1: "",
  },
]

describe Matter::Crypto::MatterCertificate::Asn1 do
  CERTIFICATE_VECTORS.each do |vector|
    it "renders #{vector[:name]} exactly as its issuer signed it" do
      certificate = TLV::Any.from_slice(vector[:tlv].hexbytes)
      Matter::Crypto::MatterCertificate::Asn1.to_unsigned_asn1(certificate).hexstring.should eq(vector[:asn1])
    end
  end

  it "expands three CASE authenticated tags where the first one appears" do
    vector = CERTIFICATE_VECTORS.find! { |candidate| candidate[:name] == "General Test Certificates NOC" }
    certificate = TLV::Any.from_slice(vector[:tlv].hexbytes)

    subject = certificate.as_structure[Matter::Crypto::MatterCertificate::Asn1::Field::Subject.value].as_list
    [0x12345678_u32, 0x56789012_u32, 0x90123456_u32].each do |tag|
      subject << TLV::Any.new(tag, Matter::Crypto::MatterCertificate::Asn1::Dn::CaseAuthenticatedTag.value)
    end

    Matter::Crypto::MatterCertificate::Asn1.to_unsigned_asn1(certificate).hexstring.should eq(
      ""
    )
  end
end
