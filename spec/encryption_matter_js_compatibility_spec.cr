require "./spec_helper"

# Encryption compatibility tests against matter.js
# These test vectors were generated by running identical encryption operations
# in both crystal-matter and matter.js implementations and verifying byte-for-byte identical output

describe "Matter.js Encryption Compatibility" do
  crypto = Matter::Crypto::StandardCrypto.new

  describe "AES-128-CCM encryption compatibility" do
    it "produces identical output to matter.js for test vector 1" do
      # Test vector 1: ReadResponse encryption with message_counter=0
      key = Bytes[0x47, 0x8e, 0xd7, 0xdc, 0x9d, 0x60, 0xd6, 0x4f, 0x18, 0x92, 0x17, 0x06, 0x04, 0x95, 0xdc, 0x2e]
      nonce = Bytes[0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00]
      aad = Bytes[0x00, 0xf7, 0x86, 0x00, 0x00, 0x00, 0x00, 0x00]
      plaintext = Bytes[0x06, 0x05, 0x76, 0xd5, 0x01, 0x00, 0xa6, 0x76, 0xe3, 0x02, 0x15, 0x36, 0x01, 0x15, 0x35, 0x01,
        0x24, 0x00, 0x00, 0x37, 0x01, 0x24, 0x02, 0x00, 0x24, 0x03, 0x1d, 0x24, 0x04, 0x00, 0x18, 0x36,
        0x02, 0x18, 0x18, 0x18, 0x15, 0x35, 0x01, 0x24, 0x00, 0x00, 0x37, 0x01, 0x24, 0x02, 0x00, 0x24,
        0x03, 0x1d, 0x24, 0x04, 0x01, 0x18, 0x36, 0x02, 0x04, 0x1d, 0x18, 0x18, 0x18, 0x15, 0x35, 0x01]

      encrypted = crypto.encrypt(key, plaintext, nonce, aad)

      # Expected output from matter.js (first 64 bytes of encrypted+MIC)
      expected_hex = "a8d4d82c8445297215d2744fdcc3f33a07f5061255662dbc69482acf87b6242b69632e0f8c3c904c647bf6a0c3868b80854c5509abe4cfab8eee8cba7cf4fdfe"
      actual_hex = encrypted[0...64].hexstring

      actual_hex.should eq(expected_hex)
    end

    it "produces identical output to matter.js for test vector 2" do
      # Test vector 2: ReadResponse encryption with message_counter=1
      key = Bytes[0x47, 0x8e, 0xd7, 0xdc, 0x9d, 0x60, 0xd6, 0x4f, 0x18, 0x92, 0x17, 0x06, 0x04, 0x95, 0xdc, 0x2e]
      nonce = Bytes[0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00]
      aad = Bytes[0x00, 0xf7, 0x86, 0x00, 0x01, 0x00, 0x00, 0x00]
      plaintext = Bytes[0x06, 0x05, 0x77, 0xd5, 0x01, 0x00, 0xa7, 0x76, 0xe3, 0x02, 0x15, 0x36, 0x01, 0x15, 0x35, 0x01,
        0x24, 0x00, 0x00, 0x37, 0x01, 0x24, 0x02, 0x00, 0x24, 0x03, 0x1d, 0x24, 0x04, 0x00, 0x18, 0x36,
        0x02, 0x18, 0x18, 0x18, 0x15, 0x35, 0x01, 0x24, 0x00, 0x00, 0x37, 0x01, 0x24, 0x02, 0x00, 0x24,
        0x03, 0x1d, 0x24, 0x04, 0x01, 0x18, 0x36, 0x02, 0x04, 0x1d, 0x18, 0x18, 0x18, 0x15, 0x35, 0x01]

      encrypted = crypto.encrypt(key, plaintext, nonce, aad)

      # Expected output from matter.js (first 64 bytes of encrypted+MIC)
      expected_hex = "ef37333aeef401a17d0994897f3ec268ce477666dd2fcc1e89964389e724fd49ee006ba428c708600275818b69f56a6df6aab77ab67346d9d1803ad662897255"
      actual_hex = encrypted[0...64].hexstring

      actual_hex.should eq(expected_hex)
    end

    it "produces identical output to matter.js for test vector 3" do
      # Test vector 3: Different session (different key), message_counter=0
      key = Bytes[0xab, 0x3e, 0x57, 0x9d, 0x5f, 0x24, 0xd4, 0x48, 0xc3, 0x38, 0x62, 0xc6, 0xcd, 0x2f, 0xa3, 0xa5]
      nonce = Bytes[0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00]
      aad = Bytes[0x00, 0x4c, 0xaf, 0x00, 0x00, 0x00, 0x00, 0x00]
      plaintext = Bytes[0x06, 0x05, 0x89, 0xe3, 0x01, 0x00, 0xac, 0xe8, 0xbe, 0x0e, 0x15, 0x36, 0x01, 0x15, 0x35, 0x01,
        0x24, 0x00, 0x00, 0x37, 0x01, 0x24, 0x02, 0x00, 0x24, 0x03, 0x1d, 0x24, 0x04, 0x00, 0x18, 0x36,
        0x02, 0x18, 0x18, 0x18, 0x15, 0x35, 0x01, 0x24, 0x00, 0x00, 0x37, 0x01, 0x24, 0x02, 0x00, 0x24,
        0x03, 0x1d, 0x24, 0x04, 0x01, 0x18, 0x36, 0x02, 0x04, 0x1d, 0x18, 0x18, 0x18, 0x15, 0x35, 0x01]

      encrypted = crypto.encrypt(key, plaintext, nonce, aad)

      # Expected output from matter.js (first 64 bytes of encrypted+MIC)
      expected_hex = "1ecf92f8047e8103e0ed22c46091e1838c8b2f619905054e67266dcc716f94e3b9df180807f7695c93e00056c8dcd165fa2230a943bc9afc433f946a4b16e3f6"
      actual_hex = encrypted[0...64].hexstring

      actual_hex.should eq(expected_hex)
    end

    it "round-trips decryption for all test vectors" do
      # Test vector 1
      key1 = Bytes[0x47, 0x8e, 0xd7, 0xdc, 0x9d, 0x60, 0xd6, 0x4f, 0x18, 0x92, 0x17, 0x06, 0x04, 0x95, 0xdc, 0x2e]
      nonce1 = Bytes[0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00]
      aad1 = Bytes[0x00, 0xf7, 0x86, 0x00, 0x00, 0x00, 0x00, 0x00]
      plaintext1 = Bytes[0x06, 0x05, 0x76, 0xd5, 0x01, 0x00, 0xa6, 0x76, 0xe3, 0x02, 0x15, 0x36, 0x01, 0x15, 0x35, 0x01,
        0x24, 0x00, 0x00, 0x37, 0x01, 0x24, 0x02, 0x00, 0x24, 0x03, 0x1d, 0x24, 0x04, 0x00, 0x18, 0x36,
        0x02, 0x18, 0x18, 0x18, 0x15, 0x35, 0x01, 0x24, 0x00, 0x00, 0x37, 0x01, 0x24, 0x02, 0x00, 0x24,
        0x03, 0x1d, 0x24, 0x04, 0x01, 0x18, 0x36, 0x02, 0x04, 0x1d, 0x18, 0x18, 0x18, 0x15, 0x35, 0x01]

      encrypted1 = crypto.encrypt(key1, plaintext1, nonce1, aad1)
      decrypted1 = crypto.decrypt(key1, encrypted1, nonce1, aad1)
      decrypted1.should eq(plaintext1)

      # Test vector 2
      key2 = Bytes[0x47, 0x8e, 0xd7, 0xdc, 0x9d, 0x60, 0xd6, 0x4f, 0x18, 0x92, 0x17, 0x06, 0x04, 0x95, 0xdc, 0x2e]
      nonce2 = Bytes[0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00]
      aad2 = Bytes[0x00, 0xf7, 0x86, 0x00, 0x01, 0x00, 0x00, 0x00]
      plaintext2 = Bytes[0x06, 0x05, 0x77, 0xd5, 0x01, 0x00, 0xa7, 0x76, 0xe3, 0x02, 0x15, 0x36, 0x01, 0x15, 0x35, 0x01,
        0x24, 0x00, 0x00, 0x37, 0x01, 0x24, 0x02, 0x00, 0x24, 0x03, 0x1d, 0x24, 0x04, 0x00, 0x18, 0x36,
        0x02, 0x18, 0x18, 0x18, 0x15, 0x35, 0x01, 0x24, 0x00, 0x00, 0x37, 0x01, 0x24, 0x02, 0x00, 0x24,
        0x03, 0x1d, 0x24, 0x04, 0x01, 0x18, 0x36, 0x02, 0x04, 0x1d, 0x18, 0x18, 0x18, 0x15, 0x35, 0x01]

      encrypted2 = crypto.encrypt(key2, plaintext2, nonce2, aad2)
      decrypted2 = crypto.decrypt(key2, encrypted2, nonce2, aad2)
      decrypted2.should eq(plaintext2)

      # Test vector 3
      key3 = Bytes[0xab, 0x3e, 0x57, 0x9d, 0x5f, 0x24, 0xd4, 0x48, 0xc3, 0x38, 0x62, 0xc6, 0xcd, 0x2f, 0xa3, 0xa5]
      nonce3 = Bytes[0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00]
      aad3 = Bytes[0x00, 0x4c, 0xaf, 0x00, 0x00, 0x00, 0x00, 0x00]
      plaintext3 = Bytes[0x06, 0x05, 0x89, 0xe3, 0x01, 0x00, 0xac, 0xe8, 0xbe, 0x0e, 0x15, 0x36, 0x01, 0x15, 0x35, 0x01,
        0x24, 0x00, 0x00, 0x37, 0x01, 0x24, 0x02, 0x00, 0x24, 0x03, 0x1d, 0x24, 0x04, 0x00, 0x18, 0x36,
        0x02, 0x18, 0x18, 0x18, 0x15, 0x35, 0x01, 0x24, 0x00, 0x00, 0x37, 0x01, 0x24, 0x02, 0x00, 0x24,
        0x03, 0x1d, 0x24, 0x04, 0x01, 0x18, 0x36, 0x02, 0x04, 0x1d, 0x18, 0x18, 0x18, 0x15, 0x35, 0x01]

      encrypted3 = crypto.encrypt(key3, plaintext3, nonce3, aad3)
      decrypted3 = crypto.decrypt(key3, encrypted3, nonce3, aad3)
      decrypted3.should eq(plaintext3)
    end
  end
end
